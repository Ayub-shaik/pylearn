# Example env file (no secrets)
APP_NAME=PyLearn
ENV=development

# --- apps/api server config ---
PORT=8081
PUBLIC_ORIGIN=https://pylearn.aysentra.com
DATABASE_URL=postgres://pylearn:pylearn@db:5432/pylearn
SESSION_SECRET=change-me-to-a-long-random-string

# Google Sign-In (create at https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI must be: https://pylearn.aysentra.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LLM routing (tiered: cache -> local Ollama -> optional cloud overflow -> template)
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_MS=8000

# Optional cloud overflow tier, off by default (NVIDIA NIM free tier)
LLM_OVERFLOW_ENABLED=false
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct

# Optional analytics (local-only by default)
ANALYTICS_ENABLED=false

